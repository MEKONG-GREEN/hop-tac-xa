# Chép thành deploy/demo/.env (đã gitignore) rồi sửa. Tệp này KHÔNG chứa bí mật: bí mật nằm trong
# deploy/compose/.env do deploy/demo/prepare.sh sinh.

# Tên miền công khai của máy demo (bản ghi A/AAAA trỏ về IP máy, mở cổng 80 và 443).
PUBLIC_HOST=demo-htx.mekonggreen.vn
PUBLIC_URL=https://demo-htx.mekonggreen.vn

# Email đăng ký Let's Encrypt (nhận cảnh báo hết hạn chứng thư).
ACME_EMAIL=

# IP/CIDR được mở bảng điều khiển Keycloak (/auth/admin, realm master). Một hoặc nhiều, cách nhau dấu cách.
# Ví dụ: 203.0.113.10/32 198.51.100.0/24
ADMIN_ALLOW_CIDR=

# IP/CIDR được gọi Admin API (/admin-api). Màn quản trị của web gọi Admin API thẳng từ trình duyệt người dùng,
# nên giới hạn ở đây là giới hạn nơi đặt máy của người quản trị. Bỏ trống = mở (vẫn bắt buộc MFA ở ứng dụng).
ADMIN_API_ALLOW_CIDR=

# Tên bucket S3 nội bộ — cũng là tiền tố đường dẫn của URL tải tệp ký sẵn (https://<host>/<bucket>/...).
# Không trùng tiền tố đường dẫn của web (vd không đặt "api", "auth", "htx").
AG_S3_BUCKET=agrigreen

# Hộp "Liên hệ quản trị viên" ở màn đăng nhập (thiếu một giá trị thì ẩn). Nhúng vào web lúc build.
NEXT_PUBLIC_SUPPORT_NAME=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# SMTP cho Keycloak (quên mật khẩu, xác minh email). Bỏ trống = không gửi mail. Mật khẩu SMTP đặt ở deploy/compose/.env.
AG_SMTP_HOST=
AG_SMTP_PORT=587
AG_SMTP_FROM=
AG_SMTP_USERNAME=

# CHỈ máy demo: 1 = Admin API không đòi TOTP. Mặc định 0 (khuyến nghị giữ MFA).
AG_MFA_DISABLED=0
